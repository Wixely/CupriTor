<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Package metadata (applied when a project opts into packing; see src/Directory.Build.props). -->
  <PropertyGroup>
    <Version>0.1.5</Version>
    <Authors>Wixely</Authors>
    <Company>Wixely</Company>
    <Product>CupriTor</Product>
    <Description>CupriTor — a 100% managed, MIT-licensed Tor client and v3 onion-service library for .NET.</Description>
    <PackageProjectUrl>https://github.com/Wixely/CupriTor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Wixely/CupriTor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>tor;onion;anonymity;privacy;managed;p2p;networking</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Only projects that opt in (src/) are packable; tests and samples are not. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Declares the GitHub Packages feed that hosts CupriCurve, alongside nuget.org.
    Credentials are intentionally NOT stored here - they come from the machine's
    user-level NuGet config or the GitHub credential provider (a PAT with read:packages).
  -->
  <packageSources>
    <add key="github-wixely" value="https://nuget.pkg.github.com/Wixely/index.json" />
  </packageSources>
</configuration>
